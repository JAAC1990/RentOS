:root {
  font-family:
    Inter, ui-sans-serif, system-ui, -apple-system,
    BlinkMacSystemFont, "Segoe UI", sans-serif;

  color: #172033;
  background: #f4f7fb;

  font-synthesis: none;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;

  --primary: #2563eb;
  --primary-dark: #1d4ed8;
  --primary-soft: #eff6ff;

  --success: #16a34a;
  --warning: #d97706;
  --danger: #dc2626;

  --text: #172033;
  --text-secondary: #64748b;
  --text-light: #94a3b8;

  --background: #f4f7fb;
  --surface: #ffffff;
  --border: #e2e8f0;

  --sidebar: #10233f;
  --sidebar-hover: #18375f;
  --sidebar-active: #2563eb;

  --shadow:
    0 4px 20px rgba(15, 23, 42, 0.06);
}

* {
  box-sizing: border-box;
}

html,
body,
#root {
  min-height: 100%;
  margin: 0;
}

body {
  min-width: 320px;
  background: var(--background);
  color: var(--text);
}

button,
input,
select,
textarea {
  font: inherit;
}

button {
  cursor: pointer;
}

a {
  color: inherit;
  text-decoration: none;
}

.app-shell {
  display: flex;
  min-height: 100vh;
}

.sidebar {
  position: fixed;
  inset: 0 auto 0 0;
  width: 250px;
  display: flex;
  flex-direction: column;
  background: var(--sidebar);
  color: white;
  z-index: 10;
}

.app-main {
  width: calc(100% - 250px);
  min-height: 100vh;
  margin-left: 250px;
}

.page-content {
  padding: 32px;
  max-width: 1600px;
  margin: 0 auto;
}

.sidebar-brand {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 24px 20px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
}

.brand-mark {
  width: 42px;
  height: 42px;
  display: grid;
  place-items: center;
  border-radius: 11px;
  background: var(--primary);
  color: white;
  font-size: 22px;
  font-weight: 800;
}

.brand-name {
  font-size: 21px;
  font-weight: 800;
}

.brand-subtitle {
  margin-top: 2px;
  color: #a9b9ce;
  font-size: 11px;
}

.sidebar-nav {
  flex: 1;
  padding: 24px 12px;
}

.nav-section-title {
  padding: 0 12px 10px;
  color: #7186a2;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 1.1px;
}

.nav-item {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 4px;
  padding: 11px 13px;
  border-radius: 9px;
  color: #c4d0df;
  font-size: 14px;
  font-weight: 500;
}

.nav-item:hover {
  background: var(--sidebar-hover);
  color: white;
}

.nav-item.active {
  background: var(--sidebar-active);
  color: white;
}

.nav-icon {
  width: 22px;
  text-align: center;
  font-size: 17px;
}

.sidebar-footer {
  padding: 18px 20px;
  border-top: 1px solid rgba(255, 255, 255, 0.08);
}

.system-status {
  display: flex;
  align-items: center;
  gap: 8px;
  color: #b8c6d8;
  font-size: 12px;
}

.status-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #22c55e;
}

.sidebar-version {
  margin-top: 8px;
  color: #7186a2;
  font-size: 11px;
}

.topbar {
  min-height: 76px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32px;
  background: var(--surface);
  border-bottom: 1px solid var(--border);
}

.topbar-title {
  font-size: 18px;
  font-weight: 700;
}

.topbar-subtitle {
  margin-top: 2px;
  color: var(--text-secondary);
  font-size: 12px;
}

.topbar-user {
  display: flex;
  align-items: center;
  gap: 10px;
}

.user-avatar {
  width: 38px;
  height: 38px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: var(--primary-soft);
  color: var(--primary);
  font-weight: 700;
}

.user-info {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.user-info strong {
  font-size: 13px;
}

.user-info span {
  color: var(--text-secondary);
  font-size: 11px;
}

.page-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 28px;
}

.page-heading h1 {
  margin: 0;
  color: var(--text);
  font-size: 30px;
  font-weight: 750;
}

.page-heading p {
  margin: 6px 0 0;
  color: var(--text-secondary);
  font-size: 14px;
}

.primary-button {
  border: 0;
  border-radius: 8px;
  padding: 10px 16px;
  background: var(--primary);
  color: white;
  font-size: 13px;
  font-weight: 650;
}

.primary-button:hover {
  background: var(--primary-dark);
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 18px;
  margin-bottom: 22px;
}

.stat-card {
  padding: 20px;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 12px;
  box-shadow: var(--shadow);
}

.stat-icon {
  width: 38px;
  height: 38px;
  display: grid;
  place-items: center;
  margin-bottom: 15px;
  border-radius: 9px;
  background: var(--primary-soft);
}

.stat-label {
  color: var(--text-secondary);
  font-size: 12px;
  font-weight: 600;
}

.stat-value {
  margin-top: 3px;
  font-size: 28px;
  font-weight: 750;
}

.stat-description {
  margin-top: 2px;
  color: var(--text-light);
  font-size: 11px;
}

.dashboard-grid {
  display: grid;
  grid-template-columns: 1.5fr 1fr;
  gap: 22px;
}

.dashboard-panel,
.content-panel {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 12px;
  box-shadow: var(--shadow);
}

.dashboard-panel {
  min-height: 300px;
}

.content-panel {
  min-height: 400px;
}

.panel-header {
  padding: 20px;
  border-bottom: 1px solid var(--border);
}

.panel-header h2 {
  margin: 0;
  color: var(--text);
  font-size: 16px;
}

.panel-header p {
  margin: 4px 0 0;
  color: var(--text-secondary);
  font-size: 12px;
}

.empty-state {
  min-height: 230px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 7px;
  padding: 30px;
  text-align: center;
  color: var(--text-secondary);
}

.empty-state-icon {
  margin-bottom: 5px;
  font-size: 32px;
}

.empty-state strong {
  color: var(--text);
  font-size: 14px;
}

.empty-state span {
  max-width: 400px;
  font-size: 12px;
  line-height: 1.5;
}

.empty-state code {
  margin-left: 4px;
  padding: 2px 5px;
  border-radius: 4px;
  background: #f1f5f9;
  color: var(--primary);
  font-size: 11px;
}

.fleet-status {
  padding: 10px 20px;
}

.fleet-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px 0;
  border-bottom: 1px solid var(--border);
  font-size: 13px;
}

.fleet-row:last-child {
  border-bottom: 0;
}

.fleet-row span {
  display: flex;
  align-items: center;
  gap: 9px;
}

.legend-dot {
  width: 9px;
  height: 9px;
  display: inline-block;
  border-radius: 50%;
}

.legend-dot.available {
  background: var(--success);
}

.legend-dot.rented {
  background: var(--primary);
}

.legend-dot.maintenance {
  background: var(--warning);
}

@media (max-width: 1100px) {
  .stats-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .dashboard-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 800px) {
  .sidebar {
    width: 76px;
  }

  .app-main {
    width: calc(100% - 76px);
    margin-left: 76px;
  }

  .brand-name,
  .brand-subtitle,
  .nav-section-title,
  .nav-item span:not(.nav-icon),
  .sidebar-footer {
    display: none;
  }

  .sidebar-brand {
    justify-content: center;
  }

  .nav-item {
    justify-content: center;
  }

  .page-content {
    padding: 22px;
  }
}

@media (max-width: 600px) {
  .topbar {
    padding: 0 18px;
  }

  .topbar-subtitle,
  .user-info {
    display: none;
  }

  .page-heading {
    align-items: flex-start;
    flex-direction: column;
  }

  .stats-grid {
    grid-template-columns: 1fr;
  }
}