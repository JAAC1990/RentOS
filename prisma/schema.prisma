generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum EstadoCliente {
  ACTIVO
  INACTIVO
  BLOQUEADO
}

enum TipoDocumento {
  CEDULA
  LICENCIA
  PASAPORTE
}

enum EstadoVehiculo {
  DISPONIBLE
  ALQUILADO
  MANTENIMIENTO
  INACTIVO
}

enum EstadoContrato {
  BORRADOR
  ACTIVO
  FINALIZADO
  CANCELADO
}

enum TipoEvidencia {
  FOTO_CLIENTE
  FOTO_VEHICULO_SALIDA
  FOTO_DEFECTO_SALIDA
  AUDIO_CONFIRMACION
  FOTO_VEHICULO_DEVOLUCION
  FOTO_DEFECTO_DEVOLUCION
}

enum TipoPago {
  EFECTIVO
  TRANSFERENCIA
  TARJETA
  PAYPAL
  OTRO
}

enum EstadoPago {
  PENDIENTE
  PAGADO
  ANULADO
}

enum RolUsuario {
  SUPERADMIN
  ADMIN_RENTCAR
  EMPLEADO
}

enum EstadoMantenimiento {
  PROGRAMADO
  EN_PROCESO
  COMPLETADO
  CANCELADO
}

model RentCar {
  id        Int      @id @default(autoincrement())
  nombre    String   // Nombre comercial (ej. "RentCar Santo Domingo")
  rnc       String?  @unique // RNC o identificación fiscal
  telefono  String?
  email     String?
  direccion String?
  ciudad                  String   @default("Santo Domingo")
  logoUrl                 String?  // URL o ruta al logo de la empresa
  moneda                  String   @default("USD") // USD, DOP, EUR
  terminosContrato        String?  // Cláusulas estándar del contrato
  limiteKilometrajeDiario Int?     @default(200)
  cargoKmExtra            Decimal? @default(0.25) @db.Decimal(10, 2)
  depositoEstandar        Decimal? @default(200.00) @db.Decimal(10, 2)
  telegramChatId          String?  // Chat ID de Telegram para recibir alertas de la empresa
  contactoNombre          String?  // Nombre del dueño / contacto solicitante
  estadoRegistro          String   @default("ACTIVO") // PENDIENTE, APROBADO, RECHAZADO, ACTIVO
  activo                  Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  usuarios       Usuario[]
  vehiculos      Vehiculo[]
  clientes       Cliente[]
  contratos      Contrato[]
  mantenimientos Mantenimiento[]
}

model Usuario {
  id        Int        @id @default(autoincrement())
  rentCarId Int?       // Opcional para SuperAdmin global, obligatorio para administradores de Rent Car
  nombre    String
  email     String     @unique
  password  String
  rol       RolUsuario @default(ADMIN_RENTCAR)
  activo    Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  rentCar             RentCar?           @relation(fields: [rentCarId], references: [id])
  clientesRegistrados UsuarioCliente[]
  consultasCredito    ConsultaCredito[]
  documentos          DocumentoCliente[]
  entregas            Entrega[]
  pagos               Pago[]

  @@index([rentCarId])
}

model Cliente {
  id              Int           @id @default(autoincrement())
  rentCarId       Int           @default(1)
  nombre          String
  apellido        String
  telefono        String
  email           String?
  direccion       String?
  fechaNacimiento DateTime?
  estado          EstadoCliente @default(ACTIVO)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  rentCar          RentCar            @relation(fields: [rentCarId], references: [id])
  usuarios         UsuarioCliente[]
  documentos       DocumentoCliente[]
  contratos        Contrato[]
  consultasCredito ConsultaCredito[]

  @@index([rentCarId])
}

model UsuarioCliente {
  usuarioId Int
  clienteId Int

  usuario Usuario @relation(fields: [usuarioId], references: [id])
  cliente Cliente @relation(fields: [clienteId], references: [id])

  @@id([usuarioId, clienteId])
}

model DocumentoCliente {
  id               Int           @id @default(autoincrement())
  clienteId        Int
  tipo             TipoDocumento
  numero           String?
  archivoUrl       String
  nombreArchivo    String
  fechaVencimiento DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  cargadoPorId     Int

  cliente    Cliente @relation(fields: [clienteId], references: [id])
  cargadoPor Usuario @relation(fields: [cargadoPorId], references: [id])

  @@index([clienteId])
}

model Vehiculo {
  id           Int            @id @default(autoincrement())
  rentCarId    Int            @default(1)
  marca        String
  modelo       String
  anio         Int
  color        String?
  placa        String         @unique
  vin          String?        @unique
  kilometraje  Int            @default(0)
  estado       EstadoVehiculo @default(DISPONIBLE)
  tarifaDiaria          Decimal        @db.Decimal(10, 2)
  seguroPoliza          String?        // Póliza de seguro (ej. "Seguros Universal #UN-9922")
  seguroVencimiento     DateTime?      // Fecha de expiración de póliza
  marbeteVencimiento    DateTime?      // Vencimiento del impuesto de circulación
  inspeccionVencimiento     DateTime?      // Vencimiento de revista / inspección técnica
  proximoMantenimientoKm    Int?           // Kilometraje para próximo cambio de aceite / mantenimiento
  proximoMantenimientoFecha DateTime?      // Fecha estimada para próximo servicio
  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt

  rentCar        RentCar         @relation(fields: [rentCarId], references: [id])
  contratos      Contrato[]
  mantenimientos Mantenimiento[]
  ubicacionesGPS UbicacionGPS[]
  transferencias TransferenciaFlota[]

  @@index([rentCarId])
}

model UbicacionGPS {
  id             Int      @id @default(autoincrement())
  vehiculoId     Int
  latitud        Float
  longitud       Float
  velocidad      Float    @default(0.0)
  rumbo          Float?   // 0 a 360 grados
  nivelBateria   Float?   @default(100.0)
  ignicion       Boolean  @default(false)
  bloqueoMotor   Boolean  @default(false)
  geocerca       String?  @default("Zona Urbana Principal")
  direccionAprox String?
  fechaHora      DateTime @default(now())

  vehiculo Vehiculo @relation(fields: [vehiculoId], references: [id])

  @@index([vehiculoId])
  @@index([fechaHora])
}

model Mantenimiento {
  id                   Int                 @id @default(autoincrement())
  rentCarId            Int                 @default(1)
  vehiculoId           Int
  tipoServicio         String              // Ej. "Cambio de Aceite y Filtro", "Frenos", "Neumáticos"
  descripcion          String?
  costo                Decimal             @default(0.00) @db.Decimal(10, 2)
  kilometrajeServicio  Int
  proximoKilometraje   Int?                // Kilometraje sugerido para siguiente mantenimiento
  proximaFechaServicio DateTime?           // Fecha estimada para siguiente servicio
  fechaServicio        DateTime            @default(now())
  taller               String?             // Taller o taller mecánico
  estado               EstadoMantenimiento @default(COMPLETADO)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  rentCar  RentCar  @relation(fields: [rentCarId], references: [id])
  vehiculo Vehiculo @relation(fields: [vehiculoId], references: [id])

  @@index([rentCarId])
  @@index([vehiculoId])
}

model Contrato {
  id                 Int            @id @default(autoincrement())
  rentCarId          Int            @default(1)
  clienteId          Int
  vehiculoId         Int
  fechaInicio        DateTime
  fechaFin           DateTime
  tarifaDiaria       Decimal        @db.Decimal(10, 2)
  deposito           Decimal        @db.Decimal(10, 2)
  kilometrajeInicial Int
  kilometrajeFinal   Int?
  estado             EstadoContrato @default(BORRADOR)
  observaciones      String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  rentCar  RentCar  @relation(fields: [rentCarId], references: [id])
  cliente  Cliente  @relation(fields: [clienteId], references: [id])
  vehiculo Vehiculo @relation(fields: [vehiculoId], references: [id])
  entrega  Entrega?
  pagos    Pago[]

  @@index([rentCarId])
  @@index([clienteId])
  @@index([vehiculoId])
}

model Entrega {
  id               Int      @id @default(autoincrement())
  contratoId       Int      @unique
  usuarioId        Int
  fechaHora        DateTime @default(now())
  kilometraje      Int
  nivelCombustible String?
  tieneDefectos    Boolean  @default(false)
  observaciones    String?

  contrato   Contrato          @relation(fields: [contratoId], references: [id])
  usuario    Usuario           @relation(fields: [usuarioId], references: [id])
  evidencias Evidencia[]
  defectos   DefectoVehiculo[]

  @@index([usuarioId])
}

model DefectoVehiculo {
  id          Int      @id @default(autoincrement())
  entregaId   Int
  descripcion String
  ubicacion   String?  // Ej. "Frente", "Puerta Izq", "Paragolpes Trasero", etc.
  tipoDano    String?  // RAYON, ABOLLADURA, GOLPE, ROTURA_VIDRIO, LLANTA
  severidad   String?  // LEVE, MEDIO, GRAVE
  coordX      Float?   // Porcentaje horizontal (0 a 100)
  coordY      Float?   // Porcentaje vertical (0 a 100)
  createdAt   DateTime @default(now())

  entrega    Entrega     @relation(fields: [entregaId], references: [id])
  evidencias Evidencia[]

  @@index([entregaId])
}

model Evidencia {
  id            Int           @id @default(autoincrement())
  entregaId     Int
  defectoId     Int?
  tipo          TipoEvidencia
  archivoUrl    String
  nombreArchivo String
  mimeType      String?
  descripcion   String?
  createdAt     DateTime      @default(now())

  entrega Entrega          @relation(fields: [entregaId], references: [id])
  defecto DefectoVehiculo? @relation(fields: [defectoId], references: [id])

  @@index([entregaId])
  @@index([defectoId])
}

model ConsultaCredito {
  id          Int      @id @default(autoincrement())
  clienteId   Int
  usuarioId   Int
  fechaHora   DateTime @default(now())
  referencia  String?
  resultado   String?
  observacion String?

  cliente Cliente @relation(fields: [clienteId], references: [id])
  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@index([clienteId])
  @@index([usuarioId])
}

model Pago {
  id         Int        @id @default(autoincrement())
  contratoId Int
  monto      Decimal    @db.Decimal(10, 2)
  fecha      DateTime   @default(now())
  tipo       TipoPago
  referencia String?
  estado     EstadoPago @default(PAGADO)
  usuarioId  Int

  contrato Contrato @relation(fields: [contratoId], references: [id])
  usuario  Usuario  @relation(fields: [usuarioId], references: [id])

  @@index([contratoId])
  @@index([usuarioId])
}

model TransferenciaFlota {
  id               Int       @id @default(autoincrement())
  vehiculoId       Int
  origenRentCarId  Int
  destinoRentCarId Int
  fechaSolicitud   DateTime  @default(now())
  fechaDevolucion  DateTime?
  tarifaPactada    Decimal   @db.Decimal(10, 2)
  estado           String    @default("PENDIENTE") // PENDIENTE, APROBADA, EN_TRANSITO, COMPLETADA, RECHAZADA
  notas            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  vehiculo Vehiculo @relation(fields: [vehiculoId], references: [id])

  @@index([vehiculoId])
  @@index([origenRentCarId])
  @@index([destinoRentCarId])
}
